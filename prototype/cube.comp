#version 450
layout(local_size_x=16,local_size_y=16) in;
layout(binding=0, rgba8) uniform writeonly image2D outputImage;
layout(push_constant) uniform Params { uint width; uint height; float time; uint swapRB; } p;
void main() {
 ivec2 pix=ivec2(gl_GlobalInvocationID.xy);
 if(pix.x>=int(p.width)||pix.y>=int(p.height)) return;
 // Repeat the same view in each eye to make the pattern easy to inspect in an HMD.
 vec2 uv=(vec2(pix)+0.5)/vec2(p.width,p.height);
 vec2 eye=vec2(fract(uv.x*2.0),uv.y);
 vec2 q=(eye*2.0-1.0)*vec2(float(p.width)*0.5/float(p.height),1.0);
 float a=p.time*0.6; float c=cos(a),s=sin(a);
 mat3 rot=mat3(c,0,s,0,1,0,-s,0,c)*mat3(1,0,0,0,cos(a*0.7),sin(a*0.7),0,-sin(a*0.7),cos(a*0.7));
 vec3 ro=rot*vec3(0,0,3.2),rd=rot*normalize(vec3(q.x,-q.y,-2.1));
 vec3 inv=1.0/rd; vec3 t0=(-vec3(0.65)-ro)*inv,t1=(vec3(0.65)-ro)*inv;
 vec3 lo=min(t0,t1),hi=max(t0,t1);
 float nearT=max(max(lo.x,lo.y),lo.z),farT=min(min(hi.x,hi.y),hi.z);
 vec3 col=vec3(0.025,0.035,0.055);
 if(farT>max(nearT,0.0)) {
  vec3 hit=ro+rd*nearT;
  vec3 face=step(vec3(0.649),abs(hit));
  vec2 f=face.x>0.5?hit.yz:(face.y>0.5?hit.xz:hit.xy);
  float tile=mod(floor((f.x+0.65)*8.0)+floor((f.y+0.65)*8.0),2.0);
  col=(face.x>0.5?vec3(0.8,0.18,0.12):(face.y>0.5?vec3(0.12,0.75,0.25):vec3(0.12,0.3,0.85)))*(0.4+0.6*tile);
 }
 // Color bars, a moving marker and thin borders reveal channel/stride/stale-frame errors.
 if(eye.y>0.88 && eye.y<0.94) {
  int b=int(eye.x*6.0); col=b==0?vec3(0.8,0,0):b==1?vec3(0,0.8,0):b==2?vec3(0,0,0.8):b==3?vec3(0.8,0.8,0):b==4?vec3(0,0.8,0.8):vec3(0.8,0,0.8);
 }
 if(abs(eye.x-fract(p.time*0.15))<0.005 && eye.y>0.77 && eye.y<0.82) col=vec3(0.8);
 if(eye.x<0.006||eye.x>0.994||eye.y<0.006||eye.y>0.994) col=vec3(0.2);
 if(p.swapRB!=0) col=col.bgr;
 imageStore(outputImage,pix,vec4(col,1));
}
